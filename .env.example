APP_NAME=SUN.AI Advanced
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
SUNAI_API_TOKEN=replace_with_a_long_random_secret
# web returns search results without calling a generative AI provider; gemini enables Gemini chat.
ASSISTANT_MODE=web
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=
DATABASE_PATH=./data/sunai.db
SESSION_SECRET=replace_with_a_different_long_random_secret
MAX_PROMPT_LENGTH=12000
MAX_MEMORY_ITEMS=100
REQUEST_TIMEOUT_SECONDS=45

# Required for web-only chat and optional web research
TAVILY_API_KEY=
